# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_URL=http://localhost:5173

# Database (MongoDB) - REQUIRED. The backend has no in-memory fallback and will
# refuse to start if this URI is missing or unreachable.
MONGO_URI=mongodb://localhost:27017/wabac
# Throwaway database used by `npm test` (it is wiped before every suite)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/wabac_test

# JWT Authentication
JWT_SECRET=wabac_jwt_super_secret_dev_key_2026
JWT_EXPIRES_IN=7d
# Buyer (shopper) sessions are longer lived than seller sessions
SHOPPER_JWT_EXPIRES_IN=30d
# Dev/test only: returns the email verification code in the API response.
# NEVER enable in production.
SHOP_OTP_DEBUG=false

# Brevo Transactional Email
# Create an API key at https://app.brevo.com/settings/keys/api and verify the
# sender/domain in Brevo before using it in production.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=orders@yourdomain.com
BREVO_SENDER_NAME=Your Store Platform
# Optional override (primarily for a local test receiver)
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT_MS=10000

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Telegram Bot Commerce
# Bot tokens are connected per seller via POST /api/telegram/connect and are
# encrypted/hidden at the model boundary; do not place seller bot tokens here.
# Public HTTPS origin used to register /webhooks/telegram/:botId.
API_PUBLIC_URL=https://api.yourdomain.com
TELEGRAM_WEBHOOK_BASE_URL=https://api.yourdomain.com
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Local `npm run telegram:poll` long-poll timeout (production uses webhooks).
TELEGRAM_POLL_TIMEOUT_SECONDS=25
# Broadcasts default to ~25/sec, below Telegram's global bot limit.
TELEGRAM_BROADCAST_DELAY_MS=40

# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Platform Fee Defaults
PLATFORM_FEE_PERCENTAGE=5
PLATFORM_FEE_FIXED=0
