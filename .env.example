# Runtime
NODE_ENV=development
PORT=5000

# Public application URLs
# CLIENT_URL is used for CORS and the storefront redirect after backend payment verification.
CLIENT_URL=http://localhost:5173
# Public HTTPS origin of this API. Required for Paystack's backend callback and
# for Telegram webhooks; it may be blank only when neither feature is used.
API_PUBLIC_URL=

# Required persistence and authentication
MONGO_URI=mongodb://127.0.0.1:27017/wabac
JWT_SECRET=replace_with_a_long_random_secret

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Your Store Platform

# Cloudinary product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI agent provider (the deterministic commerce agent works without it)
OPENAI_API_KEY=

# Paystack server-side payments and payouts
PAYSTACK_SECRET_KEY=

# Telegram bot tokens and webhook secrets are connected per seller through
# POST /api/telegram/connect and must not be stored in this file.
